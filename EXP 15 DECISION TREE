import math

# Calculate entropy
def entropy(data):
    labels = [row[-1] for row in data]
    unique_labels = set(labels)
    ent = 0
    for label in unique_labels:
        p = labels.count(label) / len(labels)
        ent -= p * math.log2(p)
    return ent

# Split dataset
def split_data(data, feature_index, value):
    return [row for row in data if row[feature_index] == value]

# Choose best feature
def best_feature_to_split(data):
    base_entropy = entropy(data)
    best_gain = 0
    best_feature = -1
    num_features = len(data[0]) - 1
    
    for f in range(num_features):
        values = set([row[f] for row in data])
        new_entropy = 0
        for value in values:
            subset = split_data(data, f, value)
            weight = len(subset) / len(data)
            new_entropy += weight * entropy(subset)
        
        gain = base_entropy - new_entropy
        
        if gain > best_gain:
            best_gain = gain
            best_feature = f
    
    return best_feature

# Build the decision tree
def build_tree(data, features):
    labels = [row[-1] for row in data]

    # If all labels are same → return label
    if labels.count(labels[0]) == len(labels):
        return labels[0]

    # No more features
    if not features:
        return max(set(labels), key=labels.count)

    best = best_feature_to_split(data)
    best_feature_name = features[best]
    tree = {best_feature_name: {}}

    values = set([row[best] for row in data])
    new_features = features[:best] + features[best+1:]

    for value in values:
        subset = split_data(data, best, value)
        reduced_subset = [row[:best] + row[best+1:] for row in subset]
        tree[best_feature_name][value] = build_tree(reduced_subset, new_features)

    return tree


