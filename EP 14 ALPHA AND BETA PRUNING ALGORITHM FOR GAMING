import math

board = [" " for _ in range(9)]

def print_board():
    print("\n")
    print(f" {board[0]} | {board[1]} | {board[2]} ")
    print("---|---|---")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("---|---|---")
    print(f" {board[6]} | {board[7]} | {board[8]} ")
    print("\n")

def check_winner(brd, player):
    win_patterns = [
        (0,1,2),(3,4,5),(6,7,8),     # rows
        (0,3,6),(1,4,7),(2,5,8),     # columns
        (0,4,8),(2,4,6)              # diagonals
    ]

    for a,b,c in win_patterns:
        if brd[a] == brd[b] == brd[c] == player:
            return True
    return False

def empty_cells(brd):
    return [i for i in range(9) if brd[i] == " "]

def is_full(brd):
    return " " not in brd


# ---------------------------------------------------
#      MINIMAX ALGORITHM WITH ALPHA-BETA PRUNING
# ---------------------------------------------------

def minimax(brd, depth, alpha, beta, is_maximizing):
    if check_winner(brd, "O"):
        return 10 - depth
    if check_winner(brd, "X"):
        return depth - 10
    if is_full(brd):
        return 0

    if is_maximizing:
        max_eval = -math.inf
        for move in empty_cells(brd):
            brd[move] = "O"
            eval = minimax(brd, depth + 1, alpha, beta, False)
            brd[move] = " "
            max_eval = max(max_eval, eval)
            alpha = max(alpha, eval)
            if beta <= alpha:       # PRUNING
                break
        return max_eval
    
    else:
        min_eval = math.inf
        for move in empty_cells(brd):
            brd[move] = "X"
            eval = minimax(brd, depth + 1, alpha, beta, True)
            brd[move] = " "
            min_eval = min(min_eval, eval)
            beta = min(beta, eval)
            if beta <= alpha:       # PRUNING
                break
        return min_eval


def ai_move():
    best_score = -math.inf
    best_move = None

    for move in empty_cells(board):
        board[move] = "O"
        score = minimax(board, 0, -math.inf, math.inf, False)
        board[move] = " "
        if score > best_score:
            best_score = score
            best_move = move

    board[best_move] = "O"


def player_move():
    while True:
        try:
            move = int(input("Enter your move (1–9): ")) - 1
            if board[move] == " ":
                board[move] = "X"
                break
            else:
                print("Spot already taken.")
        except:
            print("Invalid input.")


def game():
    print("TIC TAC TOE – Alpha-Beta AI")
    print_board()

   
