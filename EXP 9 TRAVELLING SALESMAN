import itertools

# Travelling Salesman Problem - Brute Force

def travelling_salesman(graph, start):
    cities = list(graph.keys())
    cities.remove(start)

    min_cost = float('inf')
    best_path = None

    # Try all permutations of remaining cities
    for perm in itertools.permutations(cities):
        total_cost = 0
        current = start

        # cost along the path
        for next_city in perm:
            total_cost += graph[current][next_city]
            current = next_city

        # return to start
        total_cost += graph[current][start]

        # check if it's best
        if total_cost < min_cost:
            min_cost = total_cost
            best_path = (start,) + perm + (start,)

    return best_path, min_cost


# Graph represented as adjacency matrix (dictionary)
graph = {
    'A': {'A':0, 'B':10, 'C':15, 'D':20},
    'B': {'A':10,'B':0, 'C':35, 'D':25},
    'C': {'A':15,'B':35,'C':0, 'D':30},
    'D': {'A':20,'B':25,'C':30,'D':0}
}

path, cost = travelling_salesman(graph, 'A')

print("Best Path:", " → ".join(path))
print("Minimum Cost:", cost)
