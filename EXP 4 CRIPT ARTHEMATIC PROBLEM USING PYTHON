import itertools

def solve_cryptarithm():
    letters = ('S','E','N','D','M','O','R','Y')
    digits = range(10)

    # S and M cannot be zero (leading digits)
    for perm in itertools.permutations(digits, len(letters)):
        solution = dict(zip(letters, perm))

        if solution['S'] == 0 or solution['M'] == 0:
            continue

        SEND  = 1000*solution['S'] + 100*solution['E'] + 10*solution['N'] + solution['D']
        MORE  = 1000*solution['M'] + 100*solution['O'] + 10*solution['R'] + solution['E']
        MONEY = 10000*solution['M'] + 1000*solution['O'] + 100*solution['N'] + 10*solution['E'] + solution['Y']

        if SEND + MORE == MONEY:
            print("Solution Found!")
            print(f"SEND  = {SEND}")
            print(f"MORE  = {MORE}")
            print(f"MONEY = {MONEY}")
            print("\nLetter mapping:")
            print(solution)
            return solution

    print("No solution found.")
